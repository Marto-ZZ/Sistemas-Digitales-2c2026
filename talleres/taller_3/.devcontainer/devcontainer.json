{
  "name": "sd-dev",
  "image": "docker.io/twint/sd:latest",

  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,

  "features": {},

  "runArgs": [
    "--net=host",
    "--ipc=host",
    "--env=DISPLAY=host.docker.internal:0.0"
  ],

  "containerEnv": {
    "DISPLAY": "host.docker.internal:0.0",
    "WINIT_UNIX_BACKEND": "x11",
    "WAYLAND_DISPLAY": ""
  },

  "remoteEnv": {
    "WINIT_UNIX_BACKEND": "x11",
    "WAYLAND_DISPLAY": ""
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "twint.hdl-studio",
        "surfer-project.surfer",
        "Hudson-River-Trading.vscode-slang",
        "lramseyer.vaporview",
        "kukdh1.verible-formatter"
      ]
    }
  }
}
